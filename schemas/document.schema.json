{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kvfs.local/schemas/document.schema.json",
  "title": "KVFS Document Model v0.1",
  "description": "面向 KVFS 的统一文档输出格式。统一文档模型参见 app/models.py。",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "source_path",
    "source_type",
    "source_hash",
    "parser_name",
    "parser_version",
    "elements",
    "chunks",
    "relations",
    "warnings",
    "errors",
    "metadata"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "document_id": { "type": "string", "minLength": 1 },
    "source_path": { "type": "string", "minLength": 1 },
    "source_type": { "enum": ["pdf", "docx", "markdown"] },
    "source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "parser_name": { "type": "string", "minLength": 1 },
    "parser_version": { "type": "string", "minLength": 1 },
    "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "chunks": { "type": "array", "items": { "$ref": "#/$defs/chunk" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
    "metadata": { "type": "object" }
  },
  "allOf": [
    {
      "$comment": "PDF 文档：每个 element 的 source_locator 必须含 page（≥1），bbox 可选。",
      "if": {
        "properties": { "source_type": { "const": "pdf" } },
        "required": ["source_type"]
      },
      "then": {
        "properties": {
          "elements": {
            "items": {
              "properties": {
                "source_locator": { "$ref": "#/$defs/pdf_locator" }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "DOCX 文档：source_locator 用段落/表格/单元格等结构路径，没有 page/bbox。",
      "if": {
        "properties": { "source_type": { "const": "docx" } },
        "required": ["source_type"]
      },
      "then": {
        "properties": {
          "elements": {
            "items": {
              "properties": {
                "source_locator": { "$ref": "#/$defs/docx_locator" }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "Markdown 文档：source_locator 含 line（≥1），section_path 可选。",
      "if": {
        "properties": { "source_type": { "const": "markdown" } },
        "required": ["source_type"]
      },
      "then": {
        "properties": {
          "elements": {
            "items": {
              "properties": {
                "source_locator": { "$ref": "#/$defs/markdown_locator" }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "element": {
      "type": "object",
      "required": [
        "element_id",
        "type",
        "parent_id",
        "source_locator",
        "confidence",
        "metadata"
      ],
      "anyOf": [
        {
          "required": ["content"],
          "properties": { "content": { "type": "string", "minLength": 1 } }
        },
        {
          "required": ["resource_path"],
          "properties": { "resource_path": { "type": "string", "minLength": 1 } }
        }
      ],
      "properties": {
        "element_id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "heading",
            "paragraph",
            "list_item",
            "table",
            "image",
            "caption",
            "header",
            "footer"
          ]
        },
        "content": { "type": ["string", "null"] },
        "resource_path": { "type": ["string", "null"] },
        "parent_id": { "type": ["string", "null"] },
        "source_locator": { "type": "object" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "required": ["chunk_id", "text", "source_element_ids", "metadata"],
      "properties": {
        "chunk_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "source_element_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["type", "from_id", "to_id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "from_id": { "type": "string", "minLength": 1 },
        "to_id": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "warning": {
      "type": "object",
      "required": ["code", "reason"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    },
    "pdf_locator": {
      "type": "object",
      "required": ["page"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "additionalProperties": true
    },
    "docx_locator": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "section": { "type": ["integer", "string"] },
        "paragraph_index": { "type": "integer", "minimum": 0 },
        "run_index": { "type": "integer", "minimum": 0 },
        "table_index": { "type": "integer", "minimum": 0 },
        "row_index": { "type": "integer", "minimum": 0 },
        "col_index": { "type": "integer", "minimum": 0 },
        "relationship_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "markdown_locator": {
      "type": "object",
      "required": ["line"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "section_path": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
